load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@tummycrypt_tinyland_a11y_engine_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_a11y_engine_npm//:publint/package_json.bzl", publint_bin = "bin")
load("@tummycrypt_tinyland_a11y_engine_npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("//:producer_parity.bzl", "producer_package_metadata")

npm_link_all_packages(name = "node_modules")

# First-party dep resolved through the Bazel module graph (not npm).
# tinyland-color-utils is linked from its published module's :pkg target;
# it is removed from package.json so npm_link_all_packages does not also link it.
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-color-utils",
    src = "@tummycrypt_tinyland_color_utils//:pkg",
)

ts_project(
    name = "tinyland_a11y_engine",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ),
    declaration = True,
    declaration_map = True,
    source_map = False,
    resolve_json_module = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@types/node",
        ":node_modules/svelte",
        ":node_modules/axe-core",
        ":node_modules/@tummycrypt/tinyland-color-utils",
    ],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        "README.md",
        "LICENSE",
        ":tinyland_a11y_engine",
    ],
    package = "@tummycrypt/tinyland-a11y-engine",
    version = "0.2.5",
    visibility = ["//visibility:public"],
)

# Link the package exactly as a downstream rules_js consumer does. The parity
# test imports this link, including the NpmPackageInfo-propagated color utility.
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-a11y-engine",
    src = ":pkg",
)

producer_package_metadata(
    name = "producer_parity_metadata",
    compiled = ":tinyland_a11y_engine",
    expected_dependencies = {
        "@tummycrypt/tinyland-color-utils": "0.2.3",
    },
    expected_package = "@tummycrypt/tinyland-a11y-engine",
    expected_version = "0.2.5",
    package = ":pkg",
)

js_test(
    name = "producer_parity",
    args = [
        "$(rootpath :producer_parity_metadata)",
        "$(rootpath :pkg)",
        "$(rootpath package.json)",
        "$(rootpath MODULE.bazel)",
    ],
    data = [
        ":node_modules/@tummycrypt/tinyland-a11y-engine",
        ":pkg",
        ":producer_parity_metadata",
        "MODULE.bazel",
        "package.json",
        "tests/producer-parity/package.json",
    ],
    entry_point = "tests/producer-parity/index.mjs",
    node_options = ["--experimental-import-meta-resolve"],
)

publint_bin.publint_test(
    name = "package_check",
    args = [
        "--pack=false",
        "$(rootpath :pkg)",
    ],
    data = [
        ":node_modules/publint",
        ":pkg",
    ],
)

vitest_bin.vitest_test(
    name = "test",
    data = [
        ":node_modules",
        "tsconfig.json",
        ":node_modules/vitest",
        ":node_modules/@tummycrypt/tinyland-color-utils",
        "vitest.config.ts",
    ] + glob(["src/**/*.ts"]) + glob(["tests/**/*.test.ts", "tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]),
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@types/node",
        ":node_modules/svelte",
        ":node_modules/axe-core",
        ":node_modules/@tummycrypt/tinyland-color-utils",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
